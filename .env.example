# ============================================
# Gâteaux Zohra Korichi — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Server port (optional, defaults to 3000)
PORT=3000

# Contact form email (required for live email delivery)
# CONTACT_EMAIL=zohra.korichi@example.com

# Email provider API key (required for live email delivery)
# Supports Resend, Sendgrid, or any provider you integrate in server/email.ts
# EMAIL_PROVIDER_API_KEY=your_api_key_here
